APP_HOST=127.0.0.1
APP_PORT=8088
WATCHLIST_SYMBOLS=MU,NVDA,AMD,SMH,RKLB,SPCX,ARKX,TE,FCEL,IONQ,RGTI,QBTS,QUBT,SPY,QQQ,IWM,TLT,^VIX
POLL_INTERVAL=60s
DATA_STALE_AFTER=120s
ENABLE_SCHEDULER=true

# Dedicated TradingView-Lite Postgres instance. The real password belongs only on the VPS.
DATABASE_URL=postgres://tradingview_lite:REPLACE_ON_VPS@127.0.0.1:5433/tradingview_lite?sslmode=disable

# Durable collection scheduler. Free-provider defaults are intentionally conservative.
ENABLE_COLLECTORS=true
COLLECTOR_MARKET_INTERVAL=60s
FOCUS_QUOTE_INTERVAL=30s
FOCUS_SYMBOLS=NVDA,MU,RKLB,IONQ,QQQ
RWA_COLLECT_INTERVAL=30s
RWA_FOCUS_INTERVAL=15s
RWA_SYMBOLS=NVDA,AMD
RWA_FOCUS_SYMBOLS=NVDA
OPTIONS_COLLECT_INTERVAL=5m
OPTIONS_SYMBOLS=MU,NVDA,AMD,SMH,SPY,QQQ
FEATURE_COLLECT_INTERVAL=60s
# Evaluates configured price/risk rules. Keep conservative until alert configs are approved.
ALERT_EVALUATION_INTERVAL=60s
RETENTION_INTERVAL=24h
COLLECTOR_MAX_BACKOFF=10m
YAHOO_REQUESTS_PER_MINUTE=50
OPTIONS_REQUESTS_PER_MINUTE=20
RWA_REQUESTS_PER_MINUTE=40
QUOTE_SNAPSHOT_RETENTION=336h
RWA_SNAPSHOT_RETENTION=336h
OPTION_SNAPSHOT_RETENTION=2160h
FEATURE_SNAPSHOT_RETENTION=2160h
COLLECTION_RUN_RETENTION=2160h

# Behavior-aware decision policy. This is shadow-only: it writes candidates and
# post-hoc outcomes, but never invokes Discord for market candidates or places orders.
ENABLE_BEHAVIOR_POLICY_SHADOW=true
POLICY_CANDIDATE_INTERVAL=1m
POLICY_OUTCOME_INTERVAL=5m
POLICY_CANDIDATE_COOLDOWN=30m
POLICY_DAILY_CANDIDATE_BUDGET=5
POLICY_SHADOW_SYMBOLS=MU,NVDA,RKLB,IONQ,SPY,QQQ
POLICY_CANDIDATE_RETENTION=2160h
POLICY_OUTCOME_RETENTION=2160h

# Discord webhook URLs are secrets. Fill these on the VPS, not in git.
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_SYSTEM=
DISCORD_DELIVERY_INTERVAL=10s

# Optional Bitget Wallet MCP integration for tokenized-stock/RWA proxy data.
# On vps-hk this should usually point to the local MCP service.
BITGET_MCP_URL=http://127.0.0.1:8871/mcp
BITGET_MCP_TOKEN=
RWA_SYMBOL_MAP=AAPL=AAPLon,AMD=AMDon,GOOGL=GOOGLon,META=METAon,MSFT=MSFTon,NVDA=NVDAon,TSLA=TSLAon

# Optional Yahoo Finance MCP integration for free/unofficial options-chain exploration.
# On vps-hk this should usually point to the local Yahoo MCP service.
YAHOO_MCP_URL=http://127.0.0.1:3011/mcp
YAHOO_MCP_TOKEN=

# Annualized decimal risk-free rate used by the Black-Scholes IV solver.
# Example: 0.045 means 4.5%.
OPTIONS_RISK_FREE_RATE=0.045
